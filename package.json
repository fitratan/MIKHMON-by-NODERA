{
  "name": "mikhmon-desktop-nodera",
  "productName": "Mikhmon Desktop by NODERA",
  "version": "1.0.0",
  "description": "Aplikasi Manajemen Hotspot & Billing MikroTik Standalone by NODERA",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "author": {
    "name": "NODERA",
    "email": "support@dgtlnetsolution.com",
    "url": "https://dgtlnetsolution.com"
  },
  "license": "Proprietary",
  "dependencies": {
    "axios": "^1.7.9",
    "node-machine-id": "^1.1.12",
    "portfinder": "^1.0.32"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nodera.mikhmon.desktop",
    "productName": "Mikhmon Desktop by NODERA",
    "copyright": "Copyright © 2026 NODERA. All rights reserved.",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "activation.html",
      "mikhmon/**/*",
      "bin/**/*",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "mikhmon",
        "to": "mikhmon",
        "filter": ["**/*"]
      },
      {
        "from": "bin/php-win",
        "to": "bin/php-win",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "NODERA",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mikhmon Desktop by NODERA",
      "uninstallDisplayName": "Mikhmon Desktop by NODERA",
      "artifactName": "Mikhmon-Desktop-NODERA-Setup-${version}.${ext}"
    }
  }
}